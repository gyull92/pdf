{
  "name": "gyul-pdf-viewer",
  "version": "1.2.0",
  "description": "즐겨찾기 기능이 포함된 윈도우용 PDF 뷰어",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npx concurrently \"npx vite\" \"npx electron electron/main.cjs\"",
    "build": "npx vite build",
    "start": "npx electron electron/main.cjs",
    "dist": "npm run build && npx electron-builder"
  },
  "build": {
    "appId": "com.gyul.pdfviewer",
    "productName": "귤PDF뷰어",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "dist/",
      "electron/",
      "!node_modules/canvas/**"
    ],
    "directories": {
      "buildResources": "src/assets"
    },
    "win": {
      "target": "nsis",
      "icon": "mandarinPDF3.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "mandarinPDF3.icns"
    },
    "publish": null,
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Viewer"
      }
    ]
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.8.162",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^23.6.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}

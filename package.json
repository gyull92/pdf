{
  "name": "gyul-pdf-viewer",
  "version": "1.0.0",
  "description": "즐겨찾기 기능이 포함된 윈도우용 PDF 뷰어",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron electron/main.cjs\"",
    "build": "vite build",
    "start": "electron electron/main.cjs",
    "dist": "npm run build && electron-builder build --win"
  },
  "build": {
    "appId": "com.gyul.pdfviewer",
    "productName": "귤PDF뷰어",
    "files": [
      "dist/",
      "electron/"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "pdfjs-dist": "^3.8.162",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.6.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  }
}
